<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- AndroidUpdateInstaller のダウンロード先（cacheDir/updates）を FileProvider で共有する。 -->
    <cache-path
            name="updates"
            path="updates/"/>
    <!-- 受信添付の復号済みキャッシュ（cacheDir/attachments）を開く/共有で FileProvider 経由で渡す。 -->
    <cache-path
            name="attachments"
            path="attachments/"/>
</paths>
