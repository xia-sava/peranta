<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission
            android:name="android.permission.QUERY_ALL_PACKAGES"
            tools:ignore="QueryAllPackagesPermission"/>

    <!-- コンパニオン機器としての登録に必須。登録があると通知リスナーが信頼済みとして扱われ、
         機微と判定された通知の本文も受け取れる。登録できない端末でも動くため必須にはしない。 -->
    <uses-feature
            android:name="android.software.companion_device_setup"
            android:required="false"/>
    <uses-feature
            android:name="android.hardware.telephony"
            android:required="false"/>
    <uses-feature
            android:name="android.hardware.camera"
            android:required="false"/>

    <application
            android:name=".PerantaApplication"
            android:allowBackup="false"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- 画面まわりの構成変更では作り直さず、Compose の再コンポーズで受ける。進行中のウィザードの
             位置とスキャン結果の受け取り先は Activity のインスタンスに紐づくため、作り直すと
             QR の読み取りが最初からやり直しになる。 -->
        <activity
                android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
                android:exported="true"
                android:launchMode="singleTop"
                android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>

                <category android:name="android.intent.category.DEFAULT"/>

                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>

        <!-- QR スキャナ（ZXing）のライブラリ側の宣言は sensorLandscape で、端末の自動回転を切って
             いても横向きを強制する。読み取りは短時間なので、利用者が選んでいる向きのまま
             使えるようにする。unspecified では向きの決定が端末側の判断に委ねられ、
             自動回転を切っていても横向きが選ばれうる。 -->
        <activity
                android:name="com.journeyapps.barcodescanner.CaptureActivity"
                android:screenOrientation="user"
                tools:replace="android:screenOrientation"/>

        <service
                android:name="to.sava.peranta.android.AttachmentTransferService"
                android:exported="false"
                android:foregroundServiceType="dataSync"/>

        <service
                android:name="to.sava.peranta.android.PerantaNotificationListenerService"
                android:exported="true"
                android:label="@string/app_name"
                android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <receiver
                android:name="to.sava.peranta.android.SmsReceiver"
                android:exported="true"
                android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- ミラー通知の「送信元の通知を消す」の受け口。アプリの通知からのみ起こされる。 -->
        <receiver
                android:name="to.sava.peranta.android.NotificationDismissReceiver"
                android:exported="false"/>

        <receiver
                android:name="to.sava.peranta.android.PerantaUnifiedPushReceiver"
                android:enabled="true"
                android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE"/>
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED"/>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT"/>
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED"/>
            </intent-filter>
        </receiver>

        <service
                android:name="androidx.work.impl.foreground.SystemForegroundService"
                android:foregroundServiceType="dataSync"
                tools:ignore="MissingClass"
                tools:node="merge"/>

        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.updates"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths"/>
        </provider>
    </application>

</manifest>
